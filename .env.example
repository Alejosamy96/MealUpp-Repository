# Copia este archivo como ".env" y llena los valores. El archivo ".env" NO se sube a GitHub.

# Dominio público (con DNS apuntando al servidor). Para probar en tu PC deja "localhost".
MEALUPP_DOMAIN=localhost

# Base de datos
DB_USERNAME=mealup
DB_PASSWORD=cambia-esta-clave

# Primera cuenta de administradora (se crea sola la primera vez)
STAFF_USERNAME=ferxxos
STAFF_PASSWORD=cambia-esta-clave-tambien

# Firma de los tokens: mínimo 32 caracteres. Genera una con:  openssl rand -hex 32
JWT_SECRET=
# Clave con la que la pasarela firma sus avisos. Genera una con:  openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

# Pagos
PAYMENTS_REQUIRED=true
PAYMENT_PROVIDER=sandbox
# En producción con pasarela real: false
SANDBOX_ENABLED=true

# Fotos: "local" (carpeta del servidor) o "s3" (almacenamiento de objetos + CDN)
STORAGE_TYPE=local
MEDIA_BASE_URL=/media
# Solo si STORAGE_TYPE=s3
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
